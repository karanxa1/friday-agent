# Friday environment configuration. Copy to .env and fill in.

# --- LLM provider ---
# "anthropic" = Anthropic-protocol endpoint (local proxy / direct Anthropic API)
# "vertex"    = Google Vertex AI (Gemini), auth via ADC / Cloud Run service account
FRIDAY_LLM_PROVIDER=anthropic

# --- Anthropic-protocol endpoint (used when FRIDAY_LLM_PROVIDER=anthropic) ---
FRIDAY_LLM_BASE_URL=http://localhost:8990
FRIDAY_LLM_API_KEY=your-local-llm-api-key-here

# --- Vertex AI (used when FRIDAY_LLM_PROVIDER=vertex) ---
# Gemini 3.5 Flash is served only on the "global" location.
FRIDAY_VERTEX_PROJECT=your-gcp-project-id
FRIDAY_VERTEX_LOCATION=global

# Model tiers (LiteLLM-style ids). For vertex these default to gemini-3.5-flash;
# for anthropic, "anthropic/" is added automatically if missing.
FRIDAY_MODEL_HARD=claude-opus-4-8
FRIDAY_MODEL_EASY=claude-sonnet-4-6
# Force a tier for all routing: "", "easy", or "hard"
FRIDAY_FORCE_TIER=
# Stream model reasoning (uses -thinking model variants): 1 (on) / 0 (off)
FRIDAY_THINKING=1

# --- CallMissed web search (Trend Scout) ---
# Scout falls back to canned trends if unset.
CALLMISSED_API_KEY=your-callmissed-api-key-here
CALLMISSED_BASE_URL=https://api.callmissed.com

# --- Autonomy / safety ---
# L0=suggest only, L1=act-with-approval (default), L2=trusted-auto (whitelist)
FRIDAY_AUTONOMY=L1
FRIDAY_MAX_SPAWN_DEPTH=3
FRIDAY_MAX_FANOUT=4
FRIDAY_RUN_BUDGET_SECONDS=900

# --- Runtime home ---
FRIDAY_HOME=

# --- File tool root (read/edit scope for the `files` toolset) ---
# workspace (default, sandboxed) | project (Friday's own repo) | home | <abs path>
# Widen this to give the agent broader file read/edit access. Traversal guards
# always confine access to within the chosen root.
FRIDAY_FILE_ROOT=workspace
